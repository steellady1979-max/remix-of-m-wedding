# Set these in local .env.local and in Vercel's build environment.
# Both values must come from the same active Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# Optional: ONLY for server admin operations. Never use a VITE_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=
